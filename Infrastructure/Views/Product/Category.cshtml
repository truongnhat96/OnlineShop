@model ProductModel
@{
    var categories = (await CategoryManage.GetAllCategoriesAsync()).ToList();
    var title = categories.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name ?? "Danh mục sản phẩm";
    ViewData["Title"] = title;
    var sort = Context.Request.Query["orderby"].ToString();
}
<div class="page-heading">
<div>
<span class="eyebrow">Danh mục sản phẩm</span>
<h1>@title</h1>
<p>@Model.totalProduct sản phẩm · Trang @Math.Max(1,Model.currentPage)</p>
</div>
</div>
<button type="button" class="btn btn-outline filter-toggle" data-filter-toggle aria-controls="catalog-filters" aria-expanded="false">Bộ lọc & sắp xếp</button>
<form action="/Category/@Model.CategoryId" method="get" class="filter-bar mobile-collapsed" id="catalog-filters" data-catalog-filters>
<div class="field">
<label for="category-keyword" class="form-label">Từ khóa</label>
<input class="form-control" id="category-keyword" name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Tên sản phẩm" />
</div>
<div class="field">
<label for="min-price" class="form-label">Giá từ (₫)</label>
<input class="form-control" id="min-price" type="number" min="0" name="min_price" value="@Context.Request.Query["min_price"]" />
</div>
<div class="field">
<label for="max-price" class="form-label">Giá đến (₫)</label>
<input class="form-control" id="max-price" type="number" min="0" name="max_price" value="@Context.Request.Query["max_price"]" />
</div>
<div class="field">
<label for="category-sort" class="form-label">Sắp xếp</label>
<select class="form-select" id="category-sort" name="orderby">
@foreach(var item in new[] { ("Default","Mặc định"), ("AscendingPrice","Giá tăng dần"), ("DescendingPrice","Giá giảm dần"), ("Popularity","Đã bán"), ("Date","Ngày nhập"), ("Rating","Đánh giá") }) { <option value="@item.Item1" selected="@(sort == item.Item1)">@item.Item2</option> }
</select>
</div>
<button class="btn btn-primary" type="submit">Áp dụng</button>
<a class="btn btn-outline" href="/Category/@Model.CategoryId">Xóa bộ lọc</a>
</form>
@if(Model.ProductList.Count > 0) { <div class="product-grid">@foreach(var product in Model.ProductList) { <partial name="_ProductCard" model="product" /> }</div> }
else { <partial name="_EmptyState" model='@("Chưa có sản phẩm phù hợp")' /> }
<partial name="_Pagination" model='@(new PaginationModel($"/Category/{Model.CategoryId}", Model.currentPage, Model.totalPage))' />
