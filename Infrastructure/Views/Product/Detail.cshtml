@model ProductModel
@inject EditorContentService EditorContent
@{ ViewData["Title"] = Model.Name; }
@section MetaTags {
<meta property="og:type" content="product" />
<meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
}
<div class="detail-grid">
<div class="detail-image">
<img src="/uploads/products/@Model.Image" data-fallback-image alt="@Model.Name" width="520" height="480" />
</div>
<div class="detail-info">
<span class="eyebrow">@Model.Brand</span>
<h1>@Model.Name</h1>
@if(Model.Reviews.Count > 0) {
<a class="product-review-summary" href="#reviews">
<partial name="_RatingStars" model="Model.Rating" />
<span>@Math.Clamp(Model.Rating,0,5)/5 <span class="muted">· @Model.Reviews.Count đánh giá</span></span>
</a>
}
<p class="price big-price">@Model.Price.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</p>
<dl class="detail-facts">
<div>
<dt>Thương hiệu</dt>
<dd>@Model.Brand</dd>
</div>
<div>
<dt>Tình trạng</dt>
<dd>@(Model.Quantity > 0 ? "Còn hàng" : "Hết hàng")</dd>
</div>
<div>
<dt>Danh mục</dt>
<dd>
<a href="/Category/@Model.CategoryId">@Model.CategoryName</a>
</dd>
</div>
<div>
<dt>Đã bán</dt>
<dd>@Model.Sold</dd>
</div>
</dl>
<form action="@Url.RouteUrl("cart",new { productId = Model.Id, productName = Model.Name })" method="get" class="buy-form">
<div class="field">
<label class="form-label" for="quantity">Số lượng</label>
<input class="form-control" id="quantity" name="quantity" type="number" min="1" step="1" value="1" required disabled="@(Model.Quantity <= 0)" />
</div>
<button class="btn btn-primary" type="submit" disabled="@(Model.Quantity <= 0)">@(Model.Quantity > 0 ? "Thêm vào giỏ hàng" : "Sản phẩm hết hàng")</button>
</form>
<p class="muted mt-3">Đọc kỹ mô tả và liên hệ cửa hàng nếu cần thêm thông tin trước khi lựa chọn.</p>
</div>
</div>
<section class="panel">
<h2>Mô tả sản phẩm</h2>
@if (EditorContentService.IsRichProduct(Model.Description)) {
<div class="prose rich-description">@Html.Raw(EditorContent.ProductDisplayHtml(Model.Description))</div>
} else {
<div class="prose plain-description">@Model.Description</div>
}
</section>
<section class="panel product-reviews" id="reviews" aria-labelledby="reviews-title">
<div class="reviews-heading">
<h2 id="reviews-title">Đánh giá <span class="review-count">@Model.Reviews.Count</span></h2>
@if (Model.Reviews.Count > 0) {
<div class="reviews-score">
<strong>@Math.Clamp(Model.Rating,0,5)<span>/5</span></strong>
<partial name="_RatingStars" model="Model.Rating" />
</div>
}
</div>
@if(Model.Reviews.Count == 0) {
<p class="reviews-empty">Chưa có đánh giá. Hãy chia sẻ trải nghiệm của bạn về sản phẩm.</p>
}
<div class="review-list">
@for(var index = 0; index < Model.Reviews.Count; index++) {
    var review = Model.Reviews[index];
    var reviewerName = index < Model.ReviewerName.Count && !string.IsNullOrWhiteSpace(Model.ReviewerName[index]) ? Model.ReviewerName[index] : "Khách hàng";
    var reviewScore = Math.Clamp(review.Rating, 0, 5);
    var avatarNumber = (int)((uint)review.UserId % 4) + 1;
<article class="review">
<div class="review-header">
<div class="review-author">
<img class="review-avatar" src="/images/@(avatarNumber).png" alt="" width="48" height="48" loading="lazy" />
<div class="review-author-info">
<strong class="review-author-name">@reviewerName</strong>
<div class="review-rating-line">
<partial name="_RatingStars" model="reviewScore" />
<span class="review-rating-value">@reviewScore/5</span>
</div>
</div>
</div>
<time class="review-date" datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToString("dd/MM/yyyy")</time>
</div>
@if (!string.IsNullOrWhiteSpace(review.Comment)) { <p class="review-comment">@review.Comment</p> }
</article>
}
</div>
@if(User.Identity?.IsAuthenticated == true) {
<form action="/User/Comment" method="post" class="review-form">
<input type="hidden" name="productId" value="@Model.Id" />
<h3>Đánh giá của bạn</h3>
<fieldset class="review-rating-field">
<legend>Bạn đánh giá sản phẩm này thế nào?</legend>
<div class="star-picker">
@for (var score = 1; score <= 5; score++) {
<label class="star-choice" title="@score sao">
<input type="radio" name="rating" value="@score" checked="@(score == 5)" aria-label="@score sao" />
<svg class="picker-star" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="m12 3 2.78 5.63 6.22.91-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.93 1.06-6.2L3 9.54l6.22-.91L12 3Z" />
</svg>
</label>
}
</div>
</fieldset>
<div class="field">
<label for="comment" class="form-label">Nhận xét</label>
<textarea class="form-control" name="comment" id="comment" rows="4" placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm…"></textarea>
</div>
<div class="review-form-actions">
<button class="btn btn-primary" type="submit">Gửi đánh giá</button>
</div>
</form>
} else {
<div class="review-login">
<p>Đăng nhập để chia sẻ trải nghiệm của bạn.</p>
<a class="btn btn-outline" href="/Login">Đăng nhập để đánh giá</a>
</div>
}
</section>
