@model CategoryModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Tổng quan & thêm sản phẩm"; ViewData["Admin"] = true; ViewData["Editor"] = true; }
<div class="page-heading">
<div>
<span class="eyebrow">@StoreBranding.From(StoreConfiguration).Name / Quản trị</span>
<h1>Quản lý cửa hàng</h1>
<p>Thêm sản phẩm và truy cập các công cụ quản trị.</p>
</div>
<a class="btn btn-outline" href="/">Xem cửa hàng ↗</a>
</div>
<div class="quick-links">
<a class="quick-link" href="/Product-List">
<strong>Danh sách sản phẩm ↗</strong>
<span>Tra cứu, sửa thông tin và xem số lượng.</span>
</a>
<a class="quick-link" href="/BlogList">
<strong>Quản lý bài viết ↗</strong>
<span>Biên tập nội dung và hình ảnh.</span>
</a>
<a class="quick-link" href="/api/AHP">
<strong>Số bán & tồn kho ↗</strong>
<span>Quan sát số liệu sản phẩm hiện có.</span>
</a>
</div>
<section class="panel">
<h2 class="mb-4">Thêm sản phẩm</h2>
<form action="/Add" method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<partial name="_ProductFields" model="@(ViewData["ProductForm"] as ProductModel ?? new ProductModel { CategoryList = Model.CategoryList, Date_Import = DateTime.Today })" />
<div class="form-actions">
<button class="btn btn-primary" type="submit">Lưu sản phẩm</button>
<a class="btn btn-outline" href="/Product-List">Về danh sách</a>
</div>
</form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_EditorScripts" /> }
