@model ProductModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Sửa sản phẩm"; ViewData["Admin"] = true; ViewData["Editor"] = true; }
<div class="page-heading">
<div>
<span class="eyebrow">Sản phẩm / #@Model.Id</span>
<h1>Sửa sản phẩm</h1>
<p>@Model.Name</p>
</div>
<a class="btn btn-outline" href="/Product/@Model.Id">Xem sản phẩm ↗</a>
</div>
<section class="panel">
<form action="/Edit/@Model.Id" method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<partial name="_ProductFields" model="Model" />
<div class="form-actions">
<button class="btn btn-primary" type="submit">Lưu thay đổi</button>
<a class="btn btn-outline" href="/Product-List">Hủy</a>
</div>
</form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_EditorScripts" /> }
