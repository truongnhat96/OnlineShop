@model PostModel
@{ ViewData["Title"] = "Cẩm nang xe máy"; }
<div class="page-heading">
<div>
<span class="eyebrow">Khám phá & tìm hiểu</span>
<h1>Cẩm nang xe máy</h1>
<p>Thông tin từ các bài viết của cửa hàng.</p>
</div>
</div>
<form action="/Posts" method="get" class="filter-bar">
<div class="field">
<label for="post-keyword" class="form-label">Tìm bài viết</label>
<input class="form-control" id="post-keyword" name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Nhập từ khóa…" />
</div>
<button class="btn btn-primary">Tìm kiếm</button>
</form>
@if(Model.Posts.Count == 0) { <partial name="_EmptyState" model='@("Chưa có bài viết phù hợp")' /> }
else { <div class="post-grid">@foreach(var post in Model.Posts) { <article class="post-card">
<a href="/Post/@post.Id">
<img src="/uploads/posts/@post.ImageUrl" data-fallback-image alt="@post.Title" width="400" height="220" loading="lazy" />
</a>
<div class="post-card-body">
<span class="eyebrow">@post.CreatedAt.ToString("dd/MM/yyyy")</span>
<h2 class="mt-3">
<a href="/Post/@post.Id">@post.Title</a>
</h2>
<a href="/Post/@post.Id">Đọc bài viết ↗</a>
</div>
</article> }</div> }
