@model PostModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Bài viết"; ViewData["Admin"] = true; }
<div class="page-heading">
<div>
<span class="eyebrow">Nội dung cửa hàng</span>
<h1>Bài viết</h1>
<p>@Model.Posts.Count bài viết trong danh sách hiện tại.</p>
</div>
<a class="btn btn-primary" href="/Article">+ Viết bài</a>
</div>
<section class="panel table-panel" data-admin-table>
<div class="table-toolbar">
<label class="visually-hidden" for="posts-search">Tìm bài viết</label>
<input class="form-control" id="posts-search" type="search" data-table-search placeholder="Tìm theo tiêu đề…" />
<label class="visually-hidden" for="posts-sort">Sắp xếp bài viết</label>
<select class="form-select" id="posts-sort" data-table-sort>
<option value="original">Thứ tự hiện có</option>
<option value="name">Tiêu đề A–Z</option>
<option value="date">Mới nhất</option>
</select>
</div>
<div class="table-responsive">
<table class="table">
<caption class="visually-hidden">Danh sách bài viết</caption>
<thead>
<tr>
<th scope="col">Bài viết</th>
<th scope="col">Ngày tạo</th>
<th scope="col">Thao tác</th>
</tr>
</thead>
<tbody>
@foreach(var post in Model.Posts) { <tr data-row data-search="@post.Title" data-name="@post.Title" data-date="@post.CreatedAt.Ticks">
<td>
<div class="table-product">
<img src="/uploads/posts/@post.ImageUrl" data-fallback-image alt="" width="48" height="48" />
<a href="/Post/@post.Id">@post.Title</a>
</div>
</td>
<td>@post.CreatedAt.ToString("dd/MM/yyyy")</td>
<td>
<div class="table-actions">
<a class="btn btn-outline" href="/Article/@post.Id">Sửa</a>
<a class="btn btn-outline text-danger" href="/Delete/@post.Id" data-confirm-delete="@post.Title">Xóa</a>
</div>
</td>
</tr> }
</tbody>
</table>
</div>
<div class="table-empty" data-table-empty hidden>Không có bài viết phù hợp.</div>
<partial name="_TableFooter" />
</section>
