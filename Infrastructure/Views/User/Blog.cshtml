@model PostModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Biên tập bài viết"; ViewData["Admin"] = true; ViewData["Editor"] = true; }
<div class="page-heading">
<div>
<span class="eyebrow">Cẩm nang xe máy</span>
<h1>Biên tập bài viết</h1>
<p>Chuẩn bị tiêu đề, nội dung và ảnh bìa.</p>
</div>
<a class="btn btn-outline" href="/BlogList">← Danh sách bài viết</a>
</div>
<section class="panel">
<form id="blog-form" method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" role="alert">
</div>
<div class="field mb-4">
<label asp-for="Title" class="form-label">Tiêu đề</label>
<input asp-for="Title" class="form-control" required />
<span asp-validation-for="Title">
</span>
</div>
<div class="field mb-4">
<label asp-for="Content" class="form-label">Nội dung</label>
<textarea asp-for="Content" id="post-content" class="form-control" rows="12" data-rich-editor data-editor-required="true" data-cloud-name="@EditorImageSettings.Value.CloudName" data-max-image-bytes="@EditorImageSettings.Value.MaxImageBytes">
</textarea>
<span asp-validation-for="Content">
</span>
<p id="editor-error" class="inline-error" role="alert">
</p>
</div>
<div class="field mb-4">
<label asp-for="ImageUrl" class="form-label">Ảnh bìa</label>
<input asp-for="ImageUrl" type="file" accept="image/*" class="form-control" data-image-preview="post-image-preview" required="@(Model == null || ViewData["RequireCover"] is true)" />
<span asp-validation-for="ImageUrl">
</span>
<img id="post-image-preview" class="image-preview" data-fallback-image src="@(string.IsNullOrEmpty(Model?.Image) ? "/images/motoshop-placeholder.svg" : "/uploads/posts/" + Model.Image)" alt="Xem trước ảnh bìa" />
</div>
<div class="form-actions">
<button id="post-save" class="btn btn-primary" type="submit">Lưu bài viết</button>
<a class="btn btn-outline" href="/BlogList">Hủy</a>
</div>
</form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" />
<partial name="_EditorScripts" /> }
