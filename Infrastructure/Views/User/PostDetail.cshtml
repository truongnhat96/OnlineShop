@model PostModel
@{ ViewData["Title"] = Model.Title; }
<article class="article">
<header>
<span class="eyebrow">Cẩm nang xe máy</span>
<h1 class="mt-3">@Model.Title</h1>
<p class="muted">@Model.Author · @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
</header>
<img class="article-cover" src="/uploads/posts/@Model.Image" data-fallback-image alt="@Model.Title" width="880" height="460" />
<div class="panel prose">@Html.Raw(Model.Content)</div>
<a class="btn btn-outline" href="/Posts">← Về cẩm nang</a>
</article>
