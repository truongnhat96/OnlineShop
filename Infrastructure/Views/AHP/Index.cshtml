@using Infrastructure.Models.AHP
@model AHPViewModel
@{ Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout"; ViewData["Admin"] = User.IsInRole("Admin"); ViewData["Title"] = "Số bán & tồn kho"; }
<div class="page-heading">
<div>
<span class="eyebrow">Thông tin sản phẩm</span>
<h1>Số bán & tồn kho</h1>
<p>Số liệu hiện có; không phải đánh giá chất lượng hoặc dự báo nhu cầu.</p>
</div>
</div>
@if(Model.Products.Count == 0) { <partial name="_EmptyState" model='@("Chưa có số liệu sản phẩm")' /> }
else { <section class="panel table-panel">
<div class="table-responsive">
<table class="table">
<caption class="visually-hidden">Số bán và tồn kho sản phẩm</caption>
<thead>
<tr>
<th scope="col">Sản phẩm</th>
<th scope="col">Thương hiệu</th>
<th scope="col">Đã bán</th>
<th scope="col">Số lượng</th>
<th scope="col">Giá</th>
</tr>
</thead>
<tbody>@foreach(var product in Model.Products.OrderByDescending(p=>p.Sold)) { <tr>
<td>
<a href="/Product/@product.Id">@product.Name</a>
</td>
<td>@product.Brand</td>
<td>@product.Sold</td>
<td>@product.Quantity</td>
<td>@product.Price.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</td>
</tr> }</tbody>
</table>
</div>
</section> }
