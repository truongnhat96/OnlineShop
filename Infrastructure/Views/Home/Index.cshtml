@inject IProductManage ProductManage
@{
    ViewData["Title"] = "Phụ kiện xe máy";
    var brand = StoreBranding.From(StoreConfiguration);
    var categories = (await CategoryManage.GetAllCategoriesAsync()).ToList();
    var products = (await ProductManage.GetProductsAsync()).OrderByDescending(p => p.Sold).ThenBy(p => p.Id).Take(8).ToList();
}
<section class="hero">
<div class="hero-copy">
<span class="eyebrow">@brand.Name / MOTORCYCLE ACCESSORIES</span>
<h1>Sẵn sàng cho<br />
<span>hành trình mới.</span>
</h1>
<p>@brand.Tagline. Khám phá sản phẩm, tìm hiểu thông tin và lựa chọn theo nhu cầu của bạn.</p>
<a class="btn btn-primary" href="#categories">Khám phá danh mục ↗</a>
</div>
<div class="hero-visual">
<img src="@brand.Hero" alt="Minh họa mũ bảo hiểm, găng tay và phụ kiện xe máy" width="640" height="480" />
</div>
</section>
<section id="categories">
<div class="section-heading">
<div>
<span class="eyebrow">Tìm điều bạn cần</span>
<h2>Danh mục sản phẩm</h2>
</div>
</div>
@if(categories.Count > 0) { <div class="category-grid">@foreach(var category in categories) { <a class="category-tile" href="/Category/@category.Id">@category.Name <span aria-hidden="true">↗</span>
</a> }</div> }
else { <partial name="_EmptyState" model='@("Danh mục đang được cập nhật")' /> }
</section>
<section>
<div class="section-heading">
<div>
<span class="eyebrow">Khám phá cửa hàng</span>
<h2>Sản phẩm dành cho bạn</h2>
</div>
</div>
@if(products.Count > 0) { <div class="product-grid">@foreach(var product in products) { <partial name="_ProductCard" model="product" /> }</div> }
else { <partial name="_EmptyState" model='@("Chưa có sản phẩm")' /> }</section>
<section class="panel faq mt-5">
<span class="eyebrow">Trước khi lựa chọn</span>
<h2 class="mt-2">Hiểu phụ kiện, chọn phù hợp</h2>
<details>
<summary>Làm sao chọn phụ kiện phù hợp với xe?</summary>
<p>Đối chiếu thông tin sản phẩm với mẫu xe và nhu cầu sử dụng. Nếu mô tả chưa đủ thông tin, liên hệ cửa hàng trước khi đặt mua.</p>
</details>
<details>
<summary>Tôi xem thương hiệu sản phẩm ở đâu?</summary>
<p>Thương hiệu hiển thị trên thẻ sản phẩm và trang chi tiết. Dùng ô tìm kiếm để tra cứu theo tên sản phẩm.</p>
</details>
<details>
<summary>Tôi xem thêm thông tin sản phẩm ở đâu?</summary>
<p>Mở trang chi tiết để xem mô tả, giá, số lượng đang hiển thị và đánh giá đã có.</p>
</details>
<a class="btn btn-outline mt-4" href="/Posts">Đọc cẩm nang xe máy ↗</a>
</section>
