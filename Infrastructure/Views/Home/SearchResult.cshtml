@model SearchResultModel
@{ ViewData["Title"] = "Kết quả tìm kiếm"; }
<div class="page-heading">
<div>
<span class="eyebrow">Tìm kiếm sản phẩm</span>
<h1>Kết quả cho “@Model.Keyword”</h1>
<p>Trang @Math.Max(1, Model.currentPage) / @Math.Max(1, Model.totalPage)</p>
</div>
<a class="btn btn-outline" href="/">Về cửa hàng</a>
</div>
@if(Model.Products.Count > 0) { <div class="product-grid">@foreach(var product in Model.Products) { <partial name="_ProductCard" model="product" /> }</div> }
else { <partial name="_EmptyState" model='@("Không tìm thấy sản phẩm")' /> }
<partial name="_Pagination" model='@(new PaginationModel("/Search", Model.currentPage, Model.totalPage))' />
