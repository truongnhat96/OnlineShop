@model List<CartModel>
@{ ViewData["Title"] = "Giỏ hàng"; var items = Model ?? new List<CartModel>(); var total = items.Sum(item => item.Product.Price * item.Quantity); var userId = User.Identity?.IsAuthenticated == true ? User.FindFirstValue(ClaimTypes.Sid) ?? "0" : "0"; }
<div class="page-heading">
<div>
<span class="eyebrow">Hành trình mua sắm</span>
<h1>Giỏ hàng của bạn</h1>
<p>@items.Sum(item => item.Quantity) sản phẩm</p>
</div>
</div>
@if(items.Count == 0) { <partial name="_EmptyState" model='@("Giỏ hàng đang trống")' /> } else {
<div class="commerce-grid">
<section class="panel">
<h2 class="h5">Sản phẩm đã chọn</h2>
@foreach(var item in items) {
<div class="cart-row">
<a href="/Product/@item.Product.Id">
<img src="/uploads/products/@item.Product.ImageUrl" data-fallback-image alt="@item.Product.Name" width="88" height="88" />
</a>
<div>
<h2>
<a href="/Product/@item.Product.Id">@item.Product.Name</a>
</h2>
<span class="muted">@item.Product.Brand</span>
</div>
<div class="field">
<label class="visually-hidden" for="cart-quantity-@item.Product.Id">Số lượng @item.Product.Name</label>
<input class="form-control" id="cart-quantity-@item.Product.Id" type="number" min="0" step="1" value="@item.Quantity" data-cart-quantity data-product-id="@item.Product.Id" required />
</div>
<span class="price">@item.Product.Price.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</span>
<a class="btn btn-outline remove-item" href="@Url.Action("Remove","Cart",new { productId=item.Product.Id, productName=item.Product.Name })" aria-label="Xóa @item.Product.Name khỏi giỏ">×</a>
</div>
}
<p id="cart-update-error" class="inline-error" role="alert">
</p>
<div class="cart-update-actions">
<a href="/">← Tiếp tục mua sắm</a>
<button id="cart-update" type="button" class="btn btn-outline" disabled>Cập nhật giỏ hàng</button>
</div>
</section>
<aside class="panel summary">
<h2 class="h5">Tóm tắt giỏ hàng</h2>
<div class="summary-line">
<span>Số lượng</span>
<strong>@items.Sum(item=>item.Quantity)</strong>
</div>
<div class="summary-line summary-total">
<span>Tổng tiền</span>
<span>@total.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</span>
</div>
@if(User.Identity?.IsAuthenticated == true) { <form action="/Discount" method="post" class="mb-4">
<label for="coupon" class="form-label">Mã giảm giá</label>
<input id="coupon" class="form-control mb-2" name="coupon" value="@(Context.Request.HasFormContentType ? Context.Request.Form["coupon"].ToString() : "")" placeholder="Nhập mã giảm giá" required />
<button class="btn btn-outline w-100">Áp dụng mã</button>
</form> }
else { <p class="muted">
<a href="/Login">Đăng nhập</a> để sử dụng mã giảm giá.</p> }
<a class="btn btn-primary w-100" href="/Pay/@userId" data-checkout-link>Tiến hành thanh toán ↗</a>
</aside>
</div>
}
