@using System.Text.Json
@inject ICartManage CartManage
@{
    var count = 0;
    if (User.Identity?.IsAuthenticated == true && int.TryParse(User.FindFirstValue(ClaimTypes.Sid), out var userId)) {
        count = (await CartManage.GetCartItemsAsync(userId)).Sum(item => item.Quantity);
    } else {
        var json = Context.Session.GetString(Infrastructure.Controllers.CartController.CartSessionKey);
        if (!string.IsNullOrEmpty(json)) {
            try { count = JsonSerializer.Deserialize<List<CartModel>>(json)?.Sum(item => item.Quantity) ?? 0; } catch (JsonException) { }
        }
    }
}
<span class="cart-count" aria-label="@count sản phẩm">@count</span>
