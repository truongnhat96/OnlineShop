@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }
<section class="status-card">
<div class="empty-icon" aria-hidden="true">!</div>
<h1>Chưa thể hoàn tất yêu cầu</h1>
<p class="muted">Vui lòng thử lại sau hoặc quay về cửa hàng.</p>
@if(Model?.ShowRequestId == true) { <p class="muted">Mã yêu cầu: <code>@Model.RequestId</code>
</p> }
<a href="/" class="btn btn-primary">Về cửa hàng</a>
</section>
