@{
    var brand = StoreBranding.From(StoreConfiguration);
    var categories = (await CategoryManage.GetAllCategoriesAsync()).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
<partial name="_Head" />
<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
@await RenderSectionAsync("MetaTags", required: false)</head>
<body class="storefront">
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<div class="announcement">@brand.Tagline <span>·</span> Khám phá danh mục sản phẩm</div>
<header class="store-header">
<div class="shell header-row">
<a class="brand" href="/">
<img src="@brand.Logo" alt="" width="40" height="40" />
<span>@brand.Name<span class="brand-caption">MOTORCYCLE ACCESSORIES</span>
</span>
</a>
<form class="header-search" action="/Search" method="get" role="search">
<label class="visually-hidden" for="header-keyword">Tìm sản phẩm</label>
<input id="header-keyword" type="search" name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Tìm tên sản phẩm…" />
<button type="submit" aria-label="Tìm kiếm">↗</button>
</form>
<div class="header-actions">
@if (User.Identity?.IsAuthenticated == true) {
<div class="dropdown">
<button class="btn btn-outline dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Tài khoản</button>
<ul class="dropdown-menu dropdown-menu-end">
<li class="dropdown-item-text">@User.Identity.Name</li>
@if (User.IsInRole("Admin")) { <li>
<a class="dropdown-item" href="/Manage">Trang quản trị</a>
</li> }
<li>
<a class="dropdown-item" href="/Logout">Đăng xuất</a>
</li>
</ul>
</div>
} else { <a class="account-link" href="/Login">Đăng nhập</a> }
<a class="cart-link" href="/Cart" aria-label="Giỏ hàng">Giỏ hàng <partial name="_CartPartial" />
</a>
<button class="btn btn-outline menu-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#store-menu" aria-controls="store-menu" aria-label="Mở danh mục">☰</button>
</div>
</div>
<nav class="shell store-nav" aria-label="Điều hướng cửa hàng">
<a href="/">Trang chủ</a>
<div class="dropdown">
<button class="nav-button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Danh mục sản phẩm</button>
<ul class="dropdown-menu">
@foreach (var category in categories) { <li>
<a class="dropdown-item" href="/Category/@category.Id">@category.Name</a>
</li> }
@if (categories.Count == 0) { <li class="dropdown-item-text">Chưa có danh mục</li> }
</ul>
</div>
<a href="/Posts">Cẩm nang xe máy</a>
<a href="/Home/Privacy">Quyền riêng tư</a>
</nav>
</header>
<div class="offcanvas offcanvas-start" tabindex="-1" id="store-menu" aria-labelledby="store-menu-title">
<div class="offcanvas-header">
<h2 id="store-menu-title" class="h5">@brand.Name</h2>
<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng menu">
</button>
</div>
<nav class="offcanvas-body mobile-links" aria-label="Điều hướng di động">
<a href="/">Trang chủ</a>@foreach (var category in categories) { <a href="/Category/@category.Id">@category.Name</a> }<a href="/Posts">Cẩm nang xe máy</a>
<a href="/Cart">Giỏ hàng</a>
@if (User.Identity?.IsAuthenticated == true) { @if (User.IsInRole("Admin")) { <a href="/Manage">Trang quản trị</a> }<a href="/Logout">Đăng xuất</a> } else { <a href="/Login">Đăng nhập</a>
<a href="/Signup">Đăng ký</a> }
</nav>
</div>
<main id="main-content" class="shell page-main" tabindex="-1">
<partial name="_Breadcrumb" />
<partial name="_Notice" />@RenderBody()</main>
<footer class="store-footer">
<div class="shell footer-grid">
<div>
<a class="brand" href="/">
<img src="@brand.Logo" alt="" width="40" height="40" />@brand.Name</a>
<p>@brand.Tagline</p>
</div>
<div>
<h2 class="h6">Khám phá</h2>
<a href="/Posts">Cẩm nang xe máy</a>
<a href="/Cart">Giỏ hàng của bạn</a>
</div>
<div>
<h2 class="h6">Hỗ trợ</h2>
<a href="/Home/Privacy">Chính sách quyền riêng tư</a>
<a href="https://zalo.me/0358223929">Liên hệ Zalo</a>
</div>
</div>
<div class="shell footer-bottom">© @DateTime.Now.Year @brand.Name</div>
</footer>
<partial name="_ChatWidget" />
<partial name="_Scripts" />
<script src="~/js/chat.js" asp-append-version="true" defer></script>
<script src="~/js/storefront.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts", required: false)</body>
</html>
