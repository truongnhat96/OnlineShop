@inject IProductManage ProductManage
@{ var products = (await ProductManage.GetProductsAsync()).Where(p => p.Sold > 0).OrderByDescending(p => p.Sold).Take(3).ToList(); }
@if (products.Count > 0) { <section class="panel">
<h2 class="h5">Sản phẩm được quan tâm</h2>
<div class="product-grid">@foreach(var product in products) { <partial name="_ProductCard" model="product" /> }</div>
</section> }
