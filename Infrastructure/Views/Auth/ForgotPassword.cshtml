@{ Layout = "_AuthLayout"; ViewData["Title"] = "Quên mật khẩu"; }
<span class="eyebrow">Hỗ trợ tài khoản</span>
<h2 class="mt-2">Quên mật khẩu?</h2>
<p class="muted">Nhập tên tài khoản hoặc email. Hệ thống hiện tại gửi thông tin mật khẩu đến email đã đăng ký.</p>
<form action="/ForgotPassword" method="post">
<div asp-validation-summary="All" role="alert">
</div>
<div class="field">
<label class="form-label" for="UsernameOrEmail">Tên tài khoản hoặc email</label>
<input class="form-control" id="UsernameOrEmail" name="UsernameOrEmail" value="@(Context.Request.HasFormContentType ? Context.Request.Form["UsernameOrEmail"].ToString() : "")" autocomplete="username" required />
<span>@Html.ValidationMessage("UsernameOrEmail")</span>
</div>
<button class="btn btn-primary w-100" type="submit">Gửi yêu cầu</button>
</form>
<p class="mt-4 mb-0">
<a href="/Login">← Về đăng nhập</a>
</p>
