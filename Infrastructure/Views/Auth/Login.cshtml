@model LoginModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }
<span class="eyebrow">Chào mừng trở lại</span>
<h2 class="mt-2">Đăng nhập</h2>
<p class="muted">Tiếp tục trải nghiệm mua sắm của bạn.</p>
<form action="/Login" method="post">
<div asp-validation-summary="All" role="alert">
</div>
<div class="field">
<label asp-for="Username" class="form-label">Tên tài khoản</label>
<input asp-for="Username" class="form-control" autocomplete="username" required />
<span asp-validation-for="Username">
</span>
</div>
<div class="field">
<label asp-for="Password" class="form-label">Mật khẩu</label>
<div class="password-field">
<input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
<button class="btn btn-outline" type="button" data-password-toggle="Password" aria-controls="Password" aria-pressed="false">Hiện</button>
</div>
<span asp-validation-for="Password">
</span>
</div>
<div class="auth-links">
<label>
<input asp-for="IsRememberLoginInfor" class="form-check-input" /> Ghi nhớ đăng nhập</label>
<a href="/ForgotPassword">Quên mật khẩu?</a>
</div>
<button type="submit" class="btn btn-primary w-100">Đăng nhập ↗</button>
</form>
<p class="mt-4 mb-0">Chưa có tài khoản? <a href="/Signup">Đăng ký</a>
</p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
