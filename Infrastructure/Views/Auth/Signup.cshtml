@model SignupModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng ký"; }
<span class="eyebrow">Bắt đầu cùng @StoreBranding.From(StoreConfiguration).Name</span>
<h2 class="mt-2">Tạo tài khoản</h2>
<p class="muted">Điền thông tin để đăng ký.</p>
<form action="/Signup" method="post">
<div asp-validation-summary="All" role="alert">
</div>
<div class="field">
<label asp-for="Username" class="form-label">Tên tài khoản</label>
<input asp-for="Username" class="form-control" autocomplete="username" required />
<span asp-validation-for="Username">
</span>
</div>
<div class="field">
<label asp-for="DisplayName" class="form-label">Tên hiển thị</label>
<input asp-for="DisplayName" class="form-control" autocomplete="name" required />
<span asp-validation-for="DisplayName">
</span>
</div>
<div class="field">
<label asp-for="Email" class="form-label">Email</label>
<input asp-for="Email" type="email" class="form-control" autocomplete="email" required />
<span asp-validation-for="Email">
</span>
</div>
<div class="field">
<label asp-for="Password" class="form-label">Mật khẩu</label>
<div class="password-field">
<input asp-for="Password" type="password" minlength="5" class="form-control" autocomplete="new-password" required />
<button class="btn btn-outline" type="button" data-password-toggle="Password" aria-controls="Password" aria-pressed="false">Hiện</button>
</div>
<span asp-validation-for="Password">
</span>
</div>
<div class="field">
<label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
<div class="password-field">
<input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
<button class="btn btn-outline" type="button" data-password-toggle="ConfirmPassword" aria-controls="ConfirmPassword" aria-pressed="false">Hiện</button>
</div>
<span asp-validation-for="ConfirmPassword">
</span>
</div>
<p class="muted">Xem <a href="/Home/Privacy">chính sách quyền riêng tư</a> trước khi cung cấp thông tin.</p>
<button class="btn btn-primary w-100" type="submit">Đăng ký ↗</button>
</form>
<p class="mt-4 mb-0">Đã có tài khoản? <a href="/Login">Đăng nhập</a>
</p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
