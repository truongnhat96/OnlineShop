@model string
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Xác nhận gửi email"; }
<div class="empty-icon" aria-hidden="true">✓</div>
<h2>Kiểm tra email của bạn</h2>
<p>Thông tin mật khẩu đã được gửi đến <strong>@Model</strong>.</p>
<p class="muted">Vui lòng kiểm tra hộp thư và thư mục thư rác.</p>
<a class="btn btn-primary w-100" href="/Login">Về đăng nhập</a>
