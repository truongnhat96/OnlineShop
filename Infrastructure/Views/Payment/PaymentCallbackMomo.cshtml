@using Infrastructure.Models.Momo
@model MomoExecuteResponseModel
@{
    ViewData["Title"] = "Kết quả MoMo";
    var code = TempData["CODE"];
    var success = code != null;
    double amount = 0;
    var hasAmount = double.TryParse(Model?.Amount, NumberStyles.Number, CultureInfo.InvariantCulture, out amount) && double.IsFinite(amount) && amount >= 0;
}
<section class="status-card">
<div class="empty-icon" aria-hidden="true">@(success ? "✓" : "!")</div>
<span class="eyebrow">MoMo</span>
<h1 class="mt-3">@(success ? "Giao dịch thành công" : "Giao dịch chưa thành công")</h1>
<dl>
<dt>Mã giao dịch</dt>
<dd>@(string.IsNullOrWhiteSpace(code?.ToString()) ? "Chưa có mã tham chiếu" : code)</dd>
<dt>Mã đơn hàng từ cổng thanh toán</dt>
<dd>@(string.IsNullOrWhiteSpace(Model?.OrderId) ? "Chưa có mã tham chiếu" : Model.OrderId)</dd>
<dt>Số tiền</dt>
<dd>@(hasAmount ? amount.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) + " ₫" : "Chưa có thông tin")</dd>
<dt>Nội dung</dt>
<dd>@Model?.OrderInfo</dd>
</dl>
<a class="btn btn-primary" href="/">Về cửa hàng</a>
</section>
