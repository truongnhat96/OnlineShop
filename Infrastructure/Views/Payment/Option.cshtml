@model List<CartModel>
@{ ViewData["Title"] = "Thanh toán"; var items = Model ?? new List<CartModel>(); var total = items.Sum(item => item.Product.Price * item.Quantity); var brand = StoreBranding.From(StoreConfiguration); var contact = ViewData["CodCheckout"] as CodCheckoutModel; }
<div class="page-heading">
<div>
<span class="eyebrow">Hoàn tất lựa chọn</span>
<h1>Thông tin thanh toán</h1>
<p>Kiểm tra sản phẩm và thông tin liên hệ của bạn.</p>
</div>
<a class="btn btn-outline" href="/Cart">← Giỏ hàng</a>
</div>
@if(items.Count == 0) { <partial name="_EmptyState" model='@("Không có sản phẩm để thanh toán")' /> }
else {
<div class="commerce-grid">
<div>
<section class="panel">
<h2 class="h5">Thông tin liên hệ</h2>
<form id="checkout-form" action="/CF-Order" method="post" class="form-grid">
@Html.AntiForgeryToken()
<div class="full-span" asp-validation-summary="All" role="alert"></div>
<div class="field full-span">
<label class="form-label" for="name">Họ và tên</label>
<input class="form-control" id="name" name="name" value="@contact?.Name" autocomplete="name" maxlength="100" required />
@Html.ValidationMessage("Name")
</div>
<div class="field">
<label class="form-label" for="phone">Số điện thoại</label>
<input class="form-control" id="phone" name="phone" value="@contact?.Phone" type="tel" autocomplete="tel" maxlength="30" required />
@Html.ValidationMessage("Phone")
</div>
<div class="field">
<label class="form-label" for="email">Email</label>
<input class="form-control" id="email" name="email" value="@contact?.Email" type="email" autocomplete="email" maxlength="320" required />
@Html.ValidationMessage("Email")
</div>
<div class="field full-span">
<label class="form-label" for="address">Địa chỉ nhận hàng</label>
<textarea class="form-control" id="address" name="address" rows="2" autocomplete="street-address" maxlength="1000" aria-describedby="address-help">@contact?.Address</textarea>
<small id="address-help">Bắt buộc khi đặt COD. Ghi rõ số nhà, đường, phường/xã và tỉnh/thành phố.</small>
@Html.ValidationMessage("Address")
</div>
<div class="field full-span">
<label class="form-label" for="note">Ghi chú</label>
<textarea class="form-control" id="note" name="note" rows="3" maxlength="2000" placeholder="Thông tin bạn muốn trao đổi với cửa hàng">@contact?.Note
</textarea>
</div>
<input type="hidden" name="totalAmount" value="@total" />
</form>
</section>
<section class="panel">
<h2 class="h5">Thông tin chuyển khoản</h2>
<p class="muted">Sau khi chuyển khoản, liên hệ cửa hàng để đối chiếu giao dịch. Nút xác nhận bên dưới gửi thông tin mua hàng.</p>
<div class="bank-grid">
<div class="bank-card">
<h3>MB Bank</h3>
<p>Số tài khoản: <strong>12310020049999</strong>
<br />Chủ tài khoản: <strong>Lương Nhật Trường</strong>
</p>
<img src="/images/z6421858835558_509e567814b20a267f986868c7911004.jpg" alt="Mã QR chuyển khoản ngân hàng hiện có" />
</div>
<div class="bank-card">
<h3>MoMo</h3>
<p>Số điện thoại: <strong>0359223929</strong>
<br />Chủ tài khoản: <strong>Lương Nhật Trường</strong>
</p>
<img src="/images/z6435641289089_4b7be114ab15f9b8a0d11d025f1e438b.jpg" alt="Mã QR MoMo hiện có" />
</div>
</div>
<p class="mt-3 mb-0">Liên hệ đối chiếu: <a href="https://zalo.me/0358223929">Zalo 0358223929</a>.</p>
</section>
</div>
<aside class="panel summary checkout-summary">
<h2 class="h5">Sản phẩm của bạn</h2>@foreach(var item in items) { <div class="summary-line">
<span>@item.Product.Name × @item.Quantity</span>
<strong>@((item.Product.Price * item.Quantity).ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))) ₫</strong>
</div> }
<div class="summary-line summary-total">
<span>Tổng tiền</span>
<span>@total.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</span>
</div>
<h3>Thanh toán khi nhận hàng</h3>
<p class="muted">Chọn COD để thanh toán khi nhận sản phẩm. Email xác nhận được gửi đến bạn và cửa hàng.</p>
<button id="cod-confirm" class="btn btn-primary w-100" type="submit" form="checkout-form" formaction="/Payment/PayByCod">Đặt hàng COD</button>
<hr />
<h3>Chuyển khoản ngân hàng</h3>
<p class="muted">Sử dụng thông tin chuyển khoản bên cạnh rồi gửi yêu cầu đối chiếu.</p>
<button id="bank-confirm" class="btn btn-outline w-100" type="submit" form="checkout-form">Xác nhận chuyển khoản</button>
<hr />
<h3>Thanh toán trực tuyến</h3>
@if(User.Identity?.IsAuthenticated == true) {
<div class="payment-options">
<form action="/Payment/PayByMomo" method="post">
<input type="hidden" name="FullName" value="@User.Identity.Name" />
<input type="hidden" name="Amount" value="@total" />
<input type="hidden" name="OrderInfo" value="Thanh toán đơn hàng qua MoMo tại @brand.Name" />
<button class="btn btn-outline" type="submit">MoMo ↗</button>
</form>
<form action="/Payment/PayByVnpay" method="post">
<input type="hidden" name="Name" value="@User.Identity.Name" />
<input type="hidden" name="Amount" value="@total" />
<input type="hidden" name="OrderDescription" value="Thanh toán đơn hàng qua VNPAY tại @brand.Name" />
<input type="hidden" name="OrderType" value="other" />
<button class="btn btn-outline" type="submit">VNPAY ↗</button>
</form>
</div>
} else { <p class="muted">Bạn cần <a href="/Login">đăng nhập</a> để sử dụng MoMo hoặc VNPAY trực tuyến.</p> }
</aside>
</div>
}
@section Scripts { <script src="~/js/checkout.js" asp-append-version="true"></script> }
