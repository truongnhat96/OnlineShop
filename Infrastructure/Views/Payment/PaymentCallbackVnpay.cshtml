@using Infrastructure.Models.VnPay
@model PaymentResponseModel
@{
    ViewData["Title"] = "Kết quả VNPAY";
    var success = Model?.Success == true && !string.IsNullOrEmpty(Model.TransactionId) && Model.TransactionId != "0";
    var description = Model?.OrderDescription ?? "";
    var delimiter = description.LastIndexOf('-');
    double amount = 0;
    var amountText = delimiter >= 0 ? description[(delimiter+1)..] : "";
    var hasAmount = (double.TryParse(amountText, NumberStyles.Number, CultureInfo.InvariantCulture, out amount) || double.TryParse(amountText, out amount)) && double.IsFinite(amount) && amount >= 0;
}
<section class="status-card">
<div class="empty-icon" aria-hidden="true">@(success ? "✓" : "!")</div>
<span class="eyebrow">VNPAY</span>
<h1 class="mt-3">@(success ? "Giao dịch thành công" : "Giao dịch chưa thành công")</h1>
<dl>
<dt>Mã giao dịch</dt>
<dd>@(string.IsNullOrWhiteSpace(Model?.TransactionId) ? "Chưa có mã tham chiếu" : Model.TransactionId)</dd>
<dt>Mã đơn hàng từ cổng thanh toán</dt>
<dd>@(string.IsNullOrWhiteSpace(Model?.OrderId) ? "Chưa có mã tham chiếu" : Model.OrderId)</dd>
<dt>Số tiền</dt>
<dd>@(hasAmount ? amount.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) + " ₫" : "Chưa có thông tin")</dd>
<dt>Nội dung</dt>
<dd>@(delimiter >= 0 ? description[..delimiter] : description)</dd>
</dl>
<a class="btn btn-primary" href="/">Về cửa hàng</a>
</section>
