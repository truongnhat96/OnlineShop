@model double
@{ ViewData["Title"] = "Đã tiếp nhận thông tin"; }
<section class="status-card">
<div class="empty-icon" aria-hidden="true">✓</div>
<h1>Đã tiếp nhận thông tin mua hàng</h1>
<p class="muted">Cảm ơn bạn đã gửi yêu cầu. Vui lòng kiểm tra email và liên hệ cửa hàng nếu cần đối chiếu thông tin.</p>
<dl>
<dt>Tổng tiền theo yêu cầu</dt>
<dd class="price">@Model.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</dd>
</dl>
<a class="btn btn-primary" href="/">Tiếp tục khám phá cửa hàng</a>
</section>
